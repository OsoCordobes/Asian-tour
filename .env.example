# Mapbox — token público, RESTRINGIDO por dominio en el dashboard de Mapbox.
# Sin token, el sitio usa el mapa Static (SVG) — funciona igual.
VITE_MAPBOX_TOKEN=

# Supabase — la anon key es pública por diseño; la seguridad está en RLS + slug.
# Sin estas vars, la sala de planeo persiste en localStorage (modo standalone).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
